# Option 1: single connection string (convenient for local dev)
DATABASE_URL=postgres://user:pass@localhost:5432/yoobu

# Option 2: individual credentials (recommended for Railway / production)
# DATABASE_URL is not needed when these are set
# DB_HOST=
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

RUST_LOG=yoobu_notifier=info
